          { "max": 100, "label": "Normal", "severity": "normal" },
          {
            "min": 100,
            "max": 126,
            "label": "Prediabetes",
            "severity": "attention"
          },
          { "min": 126, "label": "Diabetes", "severity": "attention" }
        ]
      },
      "HbA1c": {
        "kind": "bands",
        "unit": "%",
        "bands": [
          { "max": 5.7, "label": "Normal", "severity": "normal" },
          {
            "min": 5.7,
            "max": 6.5,
            "label": "Prediabetes",
            "severity": "attention"
          },
          { "min": 6.5, "label": "Diabetes", "severity": "attention" }
        ]
      }
    }
  },
